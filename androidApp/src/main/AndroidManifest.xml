<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cloud backup and sign-in talk to Supabase. Without this permission Android blocks every request. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTop: when the browser returns to the app through the login link, the running activity gets the
             link in onNewIntent instead of Android opening a second copy of the app. -->
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Login link: com.mehmtcan.brainscroll://login-callback (the same address is set in Supabase). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="com.mehmtcan.brainscroll"
                    android:host="login-callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
