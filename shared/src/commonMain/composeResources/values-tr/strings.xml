    <string name="guide_sudoku_only_digit">Bu hücreye yalnızca %1$d sığıyor: satırında, sütununda ve kutusunda diğerlerinin hepsi var.</string>
    <string name="guide_sudoku_only_place">%1$d, satırında, sütununda ya da kutusunda yalnızca bu hücreye girebilir.</string>
