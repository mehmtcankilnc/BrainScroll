CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

put:
INSERT OR REPLACE INTO setting(key, value) VALUES (?, ?);

get:
SELECT value FROM setting WHERE key = ?;

-- Everything except two settings: the puzzle language and the privacy choice are not about the account.
deleteAllExcept:
DELETE FROM setting WHERE key <> ? AND key <> ?;

deleteKey:
DELETE FROM setting WHERE key = ?;
